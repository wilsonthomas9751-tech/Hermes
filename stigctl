#!/usr/bin/env bash
#===============================================================================
# stigctl -- DISA/STIG compliance helper
#
# Uses OpenSCAP (oscap) to:
#   - Scan a system against an XCCDF security profile (e.g. DISA STIG)
#   - Generate reviewable remediation scripts (bash / ansible / puppet)
#   - Optionally apply remediation during scanning (--remediate)
#
# Requires: openscap-scanner (provides oscap), a SCAP data stream XML file.
#           On Debian/Ubuntu:  apt-get install openscap-scanner ssg-base
#             ssg-debian ssg-debderived ssg-nondebian ssg-applications
#           On RHEL/CentOS/Fedora: dnf install openscap-scanner scap-security-guide
#           Debian note: "scap-security-guide" is a RHEL/Fedora package name.
#             Debian splits SSG into ssg-* packages (see Install section).
#
# CPE FIX (Debian/Ubuntu): The openscap package on Debian/Ubuntu ships without
#   the CPE dictionary (/usr/share/openscap/cpe/openscap-cpe-dict.xml) -- this
#   causes "OpenSCAP Error: Unable to open file: /usr/share/openscap/cpe".
#   stigctl auto-fixes this by symlinking an SSG-provided CPE dictionary if
#   SSG content is installed. If not, it prints instructions to install SSG.
#   You can also run: stigctl fix-cpe
#
# fetch -- Pull the latest SCAP Security Guide data stream from GitHub, auto-
#            detect the target OS, extract the matching data stream, and verify
#            the SHA-512 checksum.
#===============================================================================
# IMPORTANT: Never run 'remediate' without first reviewing the generated script.
#            STIG hardening can break services, lock out remote access, etc.
#===============================================================================
set -euo pipefail

#-------------------------------------------------------------------------------
# Defaults
#-------------------------------------------------------------------------------
PROFILE="stig"
DS=""
FIX_TYPE="bash"
RESULTS_FILE="stig-results.xml"
REPORT_FILE=""
OUTPUT_SCRIPT="stig-remediation.sh"
SCAN_ARGS=""
YES=false
RESOLVED_PROFILE=""
FETCH_DIR="./stig-data"
NO_VERIFY=false
TARGET_OS=""

#-------------------------------------------------------------------------------
# Color helpers
#-------------------------------------------------------------------------------
blue()   { printf "\033[1;34m%s\033[0m\n" "$1"; }
green()  { printf "\033[1;32m%s\033[0m\n" "$1"; }
red()    { printf "\033[1;31m%s\033[0m\n" "$1"; }
yellow() { printf "\033[1;33m%s\033[0m\n" "$1"; }
die()    { red "ERROR: $1"; exit 1; }

#-------------------------------------------------------------------------------
# CPE fix -- resolves the Debian/Ubuntu missing CPE dictionary bug
#-------------------------------------------------------------------------------
fix_cpe() {
    local cpe_dir="/usr/share/openscap/cpe"
    local cpe_file="${cpe_dir}/openscap-cpe-dict.xml"
    local ssg_cpe_dir="/usr/share/xml/scap/ssg/content"

    # Already fixed?
    if [[ -f "$cpe_file" ]]; then
        return 0
    fi

    # Create the cpe directory if needed
    if [[ ! -d "$cpe_dir" ]]; then
        if [[ $EUID -eq 0 ]]; then
            mkdir -p "$cpe_dir"
        else
            if sudo mkdir -p "$cpe_dir" 2>/dev/null; then
                : # created
            else
                _cpe_error
                return 1
            fi
        fi
    fi

    # Look for SSG CPE dictionaries to symlink
    if [[ -d "$ssg_cpe_dir" ]]; then
        local ssg_cpe_files
        ssg_cpe_files=$(find "$ssg_cpe_dir" -name "*-cpe-dictionary.xml" -type f 2>/dev/null | head -5)
        if [[ -n "$ssg_cpe_files" ]]; then
            local chosen
            chosen=$(echo "$ssg_cpe_files" | grep -i "debian\|ubuntu" | head -1)
            [[ -z "$chosen" ]] && chosen="$ssg_cpe_files"
            chosen=$(echo "$chosen" | head -1)

            if [[ -n "$chosen" && -f "$chosen" ]]; then
                if [[ $EUID -eq 0 ]]; then
                    ln -sf "$chosen" "$cpe_file"
                else
                    sudo ln -sf "$chosen" "$cpe_file" 2>/dev/null || {
                        echo "  Failed to create symlink. Run manually:"
                        echo "    sudo ln -sf $chosen $cpe_file"
                        return 1
                    }
                fi
                green "CPE dictionary symlinked: $cpe_file -> $(basename "$chosen")"
                return 0
            fi
        fi
    fi

    _cpe_error
    return 1
}

_cpe_error() {
    echo "  CPE directory missing: $cpe_dir"
    echo "  This is a known Debian/Ubuntu packaging bug."
    echo "  Fix with: sudo mkdir -p $cpe_dir"
    echo ""
    echo "  Then symlink an SSG CPE dictionary (if SSG is installed):"
    echo "    sudo ln -sf /usr/share/xml/scap/ssg/content/ssg-<os>-cpe-dictionary.xml $cpe_file"
    echo ""
    echo "  Or run: stigctl fix-cpe   (requires sudo)"
    echo ""
    echo "  Alternatively, install SSG content which provides CPE dicts:"
    echo "    Debian/Ubuntu: apt-get install ssg-base ssg-debian ssg-debderived ssg-nondebian ssg-applications"
    echo "    RHEL/CentOS:   dnf install scap-security-guide"
}

cmd_fix_cpe() {
    blue "Checking/fixing CPE dictionary for OpenSCAP ..."
    if fix_cpe; then
        green "CPE dictionary is in place."
    else
        red "CPE fix failed. See messages above."
        exit 1
    fi
}

#-------------------------------------------------------------------------------
# Profile resolution -- maps short names to full XCCDF profile IDs
#-------------------------------------------------------------------------------
resolve_profile() {
    local ds="$1"
    local short="$2"

    # Full XCCDF ID already?
    if [[ "$short" == xccdf_org.* ]]; then
        echo "$short"
        return 0
    fi

    # Query the data stream
    local profiles
    profiles=$(oscap xccdf info --profiles "$ds" 2>/dev/null) || true

    if [[ -z "$profiles" ]]; then
        # Fallback: common full IDs
        case "$short" in
            stig)   echo "xccdf_org.ssgproject.content_profile_stig" ;;
            ospp)   echo "xccdf_org.ssgproject.content_profile_ospp" ;;
            cis)    echo "xccdf_org.ssgproject.content_profile_cis" ;;
            standard) echo "xccdf_org.ssgproject.content_profile_standard" ;;
            *)      echo "$short" ;;
        esac
        return 0
    fi

    # Try exact match: content_profile_<short>
    local found
    found=$(echo "$profiles" | grep -oP "xccdf_org\.ssgproject\.content_profile_${short}[^\s]*" | head -1)
    if [[ -n "$found" ]]; then
        echo "$found"
        return 0
    fi

    # Try suffix match
    found=$(echo "$profiles" | grep -oP "xccdf_org\.ssgproject\.content_profile_[^\s]*" | grep -i "${short}$" | head -1)
    if [[ -n "$found" ]]; then
        echo "$found"
        return 0
    fi

    # Not found
    yellow "Profile '$short' not found in data stream. Available profiles:"
    echo "$profiles" | grep -oE "xccdf_org\.ssgproject\.content_profile_[^\s]*" | head -10 | while read -r p; do
        yellow "  $p"
    done
    echo "$short"
}

#-------------------------------------------------------------------------------
# Checks
#-------------------------------------------------------------------------------
check_oscap() {
    if ! command -v oscap &>/dev/null; then
        die "oscap not found. Install with:\n  Debian/Ubuntu:  apt-get install openscap-scanner\n  RHEL/CentOS:    dnf install openscap-scanner\n  Fedora:         dnf install openscap-scanner"
    fi
    fix_cpe || true
}

check_fetch_tools() {
    local missing=()
    for tool in curl jq unzip sha512sum; do
        if ! command -v "$tool" &>/dev/null; then
            missing+=("$tool")
        fi
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        die "Missing required tools for fetch: ${missing[*]}.\n  Debian/Ubuntu:  apt-get install curl jq unzip coreutils\n  RHEL/CentOS:    dnf install curl jq unzip sha256sum"
    fi
}

check_ds() {
    if [[ -z "$DS" ]]; then
        die "No data stream specified. Use --ds <path-to-scap-ds.xml>"
    fi
    if [[ ! -f "$DS" ]]; then
        die "Data stream file not found: $DS"
    fi
}

require_yes() {
    if [[ "$YES" != "true" ]]; then
        die "Refusing to remediate without --yes. Run with --yes to confirm."
    fi
}

#-------------------------------------------------------------------------------
# Usage
#-------------------------------------------------------------------------------
usage() {
    cat <<EOF
Usage: $(basename "$0") <command> [options]

Commands:
  scan         Scan system against STIG profile. Outputs XCCDF results XML.
  plan         Scan, then generate a reviewable remediation script (safe).
  remediate    Scan and apply fixes in one pass (DANGEROUS -- requires --yes).
  generate     Generate remediation script for ALL rules in profile (no scan).
  list-profiles List available XCCDF profiles in the data stream.
  info         Show data-stream metadata.
  fetch        Download latest SCAP Security Guide data stream from GitHub.
  fix-cpe       Fix the missing CPE dictionary on Debian/Ubuntu (requires sudo).

Options:
  --profile <id>        XCCDF profile name or ID (default: "stig").
                        Short names like "stig" are auto-resolved to the full
                        XCCDF ID (e.g. xccdf_org.ssgproject.content_profile_stig).
                        Use the full ID directly if auto-resolution fails.
  --ds <file>           Path to SCAP data stream XML
  --fix-type <type>     Remediation format: bash, ansible, puppet, anaconda,
                        ignition, kickstart, blueprint (default: bash)
  --output <file>       Output script filename (default: stig-remediation.sh)
  --results <file>      Results XML filename (default: stig-results.xml)
  --report <htmlfile>   Also produce an HTML report
  --extra "..."         Extra args forwarded to oscap xccdf eval
  --yes                 required for 'remediate' (acknowledge risk)
  --target-os <id>      OS ID for fetch (e.g. rhel9, ubuntu2404, debian12).
                        Auto-detected if omitted.
  --output-dir <dir>    Directory to write fetched data stream (default: ./stig-data)
  --no-verify           Skip SHA-512 checksum verification (not recommended)
  -h, --help            Show this help

Examples:
  # Install prerequisites (Debian/Ubuntu)
  sudo apt-get install -y openscap-scanner ssg-base ssg-debian ssg-debderived \
    ssg-nondebian ssg-applications curl jq unzip

  # Fix CPE dictionary (run once, requires sudo)
  $(basename "$0") fix-cpe

  # List profiles in a data stream
  $(basename "$0") list-profiles --ds /usr/share/xml/scap/ssg/content/ssg-rhel8-ds.xml

  # Download latest STIG content for this system's OS, then scan
  $(basename "$0") fetch --target-os debian12
  $(basename "$0") scan --ds stig-data/ssg-debian12-ds.xml --profile stig

  # Use full profile ID directly (if auto-resolution fails)
  $(basename "$0") scan --ds stig-data/ssg-rhel8-ds.xml \
    --profile xccdf_org.ssgproject.content_profile_stig

  # Fetch for a specific OS and put it in a custom directory
  $(basename "$0") fetch --target-os rhel9 --output-dir /opt/stig

  # Fetch everything (all OS data streams) -- large download
  $(basename "$0") fetch --output-dir /opt/stig/all
EOF
    exit 0
}

#-------------------------------------------------------------------------------
# Argument parsing
#-------------------------------------------------------------------------------
parse_args() {
    local cmd="$1"; shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --profile)    PROFILE="$2";        shift 2 ;;
            --ds)         DS="$2";            shift 2 ;;
            --fix-type)   FIX_TYPE="$2";      shift 2 ;;
            --output)     OUTPUT_SCRIPT="$2"; shift 2 ;;
            --results)    RESULTS_FILE="$2";  shift 2 ;;
            --report)     REPORT_FILE="$2";   shift 2 ;;
            --extra)      SCAN_ARGS="$2";     shift 2 ;;
            --yes)        YES=true;           shift ;;
            --target-os)  TARGET_OS="$2";     shift 2 ;;
            --output-dir) FETCH_DIR="$2";     shift 2 ;;
            --no-verify)  NO_VERIFY=true;     shift ;;
            -h|--help)    usage ;;
            *)            die "Unknown option: $1" ;;
        esac
    done

    [[ -z "${FETCH_DIR:-}" ]] && FETCH_DIR="./stig-data"
    [[ -z "${NO_VERIFY:-}" ]] && NO_VERIFY=false

    case "$cmd" in
        scan|plan|remediate)   check_oscap; check_ds ;;
        generate)              check_oscap; check_ds ;;
        list-profiles|info)    check_oscap; check_ds ;;
        fetch)                 check_fetch_tools ;;
        fix-cpe)               ;;
        *) die "Unknown command: $cmd" ;;
    esac
}

#-------------------------------------------------------------------------------
# Commands
#-------------------------------------------------------------------------------
cmd_list_profiles() {
    blue "Available XCCDF profiles in: $DS"
    RESOLVED_PROFILE=$(resolve_profile "$DS" "$PROFILE")
    oscap xccdf info --profiles "$DS" 2>/dev/null | grep -E "^\s+[a-zA-Z0-9]" \
        || oscap xccdf info --profiles "$DS"
    green ""
    green "To scan, use: $(basename "$0") scan --ds $DS --profile $RESOLVED_PROFILE"
}

cmd_info() {
    blue "Data stream info: $DS"
    oscap info "$DS"
}

cmd_scan() {
    RESOLVED_PROFILE=$(resolve_profile "$DS" "$PROFILE")

    local eval_args=(xccdf eval)
    eval_args+=(--profile "$RESOLVED_PROFILE")
    eval_args+=(--results "$RESULTS_FILE")
    [[ -n "$REPORT_FILE" ]] && eval_args+=(--report "$REPORT_FILE")
    [[ -n "$SCAN_ARGS" ]]     && eval_args+=($SCAN_ARGS)
    eval_args+=($DS)

    green "Scanning against profile '$RESOLVED_PROFILE' ..."
    if [[ -n "$REPORT_FILE" ]]; then
        green "Results -> $RESULTS_FILE   HTML report -> $REPORT_FILE"
    else
        green "Results -> $RESULTS_FILE"
    fi

    sudo oscap "${eval_args[@]}"
    green "Scan complete."
}

cmd_generate() {
    check_ds
    RESOLVED_PROFILE=$(resolve_profile "$DS" "$PROFILE")
    green "Generating $FIX_TYPE remediation script for ALL rules in profile '$RESOLVED_PROFILE' ..."
    green "Output -> $OUTPUT_SCRIPT"

    oscap xccdf generate fix \
        --profile "$RESOLVED_PROFILE" \
        --fix-type "$FIX_TYPE" \
        --output "$OUTPUT_SCRIPT" \
        "$DS"

    green "Done. Review $OUTPUT_SCRIPT before applying."
    if [[ "$FIX_TYPE" == "bash" ]]; then
        yellow "Make it executable: chmod +x $OUTPUT_SCRIPT"
    fi
}

cmd_plan() {
    green "=== Phase 1: Scanning ==="
    RESOLVED_PROFILE=$(resolve_profile "$DS" "$PROFILE")
    local eval_args=(xccdf eval --profile "$RESOLVED_PROFILE" --results "$RESULTS_FILE")
    [[ -n "$SCAN_ARGS" ]] && eval_args+=($SCAN_ARGS)
    eval_args+=($DS)

    sudo oscap "${eval_args[@]}"
    green "Scan complete -> $RESULTS_FILE"

    green "=== Phase 2: Generating remediation script ==="
    oscap xccdf generate fix \
        --result-id "xccdf_org.open-scap_testresult_$(grep -oP 'xccdf_org\.[^ ]+' "$RESULTS_FILE" 2>/dev/null | head -1 || echo '')" \
        --fix-type "$FIX_TYPE" \
        --output "$OUTPUT_SCRIPT" \
        "$RESULTS_FILE" 2>/dev/null \
        || oscap xccdf generate fix \
            --profile "$RESOLVED_PROFILE" \
            --fix-type "$FIX_TYPE" \
            --output "$OUTPUT_SCRIPT" \
            "$RESULTS_FILE"

    green "Reviewable script -> $OUTPUT_SCRIPT"
    yellow "Review the script before running it!"
    if [[ "$FIX_TYPE" == "bash" ]]; then
        yellow "Apply later: sudo bash $OUTPUT_SCRIPT"
    fi
}

cmd_remediate() {
    require_yes
    RESOLVED_PROFILE=$(resolve_profile "$DS" "$PROFILE")
    green "=== Remediating profile '$RESOLVED_PROFILE' (LIVE) ==="
    green "This will modify the system. Review the generated script first if unsure."
    green "Data stream: $DS"

    local eval_args=(xccdf eval --profile "$RESOLVED_PROFILE" --remediate)
    [[ -n "$SCAN_ARGS" ]] && eval_args+=($SCAN_ARGS)
    eval_args+=($DS)

    sudo oscap "${eval_args[@]}"
    green "Remediation complete. Check results."
}

#-------------------------------------------------------------------------------
# OS detection
#-------------------------------------------------------------------------------
detect_os() {
    if [[ ! -f /etc/os-release ]]; then
        die "Cannot auto-detect OS: /etc/os-release not found. Use --target-os."
    fi
    local id variant version
    id=$(grep -oP '^ID=[\"\'']*\K[^\"\'\\'']+' /etc/os-release | tr '[:upper:]' '[:lower:]')
    variant=$(grep -oP '^ID_LIKE=[\"\'']*\K[^\"\'\\'']+' /etc/os-release | tr '[:upper:]' '[:lower:]' || true)
    version=$(grep -oP '^VERSION_ID=[\"\'']*\K[^\"\'\\'']+' /etc/os-release || true)

    case "$id" in
        debian)
            if [[ "$version" == "13" ]]; then
                yellow "Debian 13 (trixie) has no SSG content yet. Falling back to debian12."
                echo "debian12"
            else
                echo "debian${version:-unknown}"
            fi
            ;;
        ubuntu)
            echo "ubuntu${version:-unknown}"
            ;;
        rhel|centos|rocky|almalinux|ol|oraclelinux|fedora)
            echo "${id}${version:-unknown}"
            ;;
        *)
            if [[ -n "$variant" ]]; then
                case "$variant" in
                    debian) echo "debian12" ;;
                    ubuntu) echo "ubuntu${version:-unknown}" ;;
                    rhel)   echo "rhel${version:-unknown}" ;;
                    *)      die "Unable to map OS '$id' (ID_LIKE=$variant) to an SSG data stream. Use --target-os." ;;
                esac
            else
                die "Unable to map OS '$id' to an SSG data stream. Use --target-os."
            fi
            ;;
    esac
}

#-------------------------------------------------------------------------------
# fetch -- download latest SSG data stream from GitHub
#-------------------------------------------------------------------------------
cmd_fetch() {
    local os_id="${TARGET_OS:-}"
    local out_dir="${FETCH_DIR:-}"
    local verify="${NO_VERIFY:-}"

    if [[ -z "$os_id" ]]; then
        blue "Auto-detecting target OS from /etc/os-release ..."
        os_id=$(detect_os)
        green "Detected OS: $os_id"
    fi

    if [[ "$os_id" != *"-ds.xml" ]] && [[ "$os_id" != *ssg-* ]]; then
        os_id="ssg-${os_id}-ds.xml"
    fi

    green "Fetching latest SCAP Security Guide data stream for: $os_id"

    blue "Querying GitHub API for latest ComplianceAsCode/content release ..."
    local release_json
    release_json=$(curl -sSfL "https://api.github.com/repos/ComplianceAsCode/content/releases/latest" 2>/dev/null)
    if [[ -z "$release_json" ]]; then
        die "Failed to query GitHub API. Check network connectivity."
    fi
    local tag_name
    tag_name=$(echo "$release_json" | jq -r '.tag_name // empty')
    if [[ -z "$tag_name" || "$tag_name" == "null" ]]; then
        die "Unexpected GitHub API response: $(echo "$release_json" | jq -r '.message // "no tag_name"')"
    fi
    local version="${tag_name#v}"
    green "Latest release: $tag_name (version: $version)"

    local zip_name="scap-security-guide-${version}.zip"
    local zip_url="https://github.com/ComplianceAsCode/content/releases/download/${tag_name}/${zip_name}"
    local sha_name="scap-security-guide-${version}.zip.sha512"
    local sha_url="https://github.com/ComplianceAsCode/content/releases/download/${tag_name}/${sha_name}"

    blue "Downloading $zip_name (~30-50 MB, may take a moment) ..."
    local tmp_dir
    tmp_dir=$(mktemp -d)
    local zip_path="$tmp_dir/$zip_name"
    local sha_path="$tmp_dir/$sha_name"

    curl -sSfL "$zip_url" -o "$zip_path" || die "Download failed: $zip_url"
    curl -sSfL "$sha_url" -o "$sha_path" || die "Checksum download failed: $sha_url"
    green "Downloaded $zip_name and $sha_name"

    if [[ "$verify" != "true" ]]; then
        blue "Verifying SHA-512 checksum ..."
        local expected actual
        expected=$(cat "$sha_path" | awk '{print $1}')
        actual=$(sha512sum "$zip_path" | awk '{print $1}')
        if [[ "$expected" != "$actual" ]]; then
            die "SHA-512 mismatch!\n  expected: $expected\n  actual:   $actual\nThe download may be corrupted or tampered with. Do not use this file."
        fi
        green "Checksum verified OK."
    else
        yellow "Skipping checksum verification (--no-verify)."
    fi

    blue "Extracting $os_id from archive ..."
    mkdir -p "$out_dir"
    unzip -q -o "$zip_path" -d "$tmp_dir" || die "Failed to extract ZIP."

    local ds_source="$tmp_dir/${zip_name%.zip}/$os_id"
    if [[ ! -f "$ds_source" ]]; then
        yellow "Requested data stream '$os_id' not found in archive."
        yellow "Available data streams (first 20):"
        find "$tmp_dir/${zip_name%.zip}" -name "*-ds.xml" | head -20 | while read -r f; do
            echo "  $(basename "$f")"
        done
        die "Cannot continue. Use --target-os with one of the above names."
    fi

    local ds_dest="$out_dir/$os_id"
    cp "$ds_source" "$ds_dest"
    green "Data stream written to: $ds_dest"
    green "To scan this data stream, use:"
    green "  $(basename "$0") scan --ds $ds_dest --profile stig"
    green ""
    green "If 'stig' doesn't work, list available profiles first:"
    green "  $(basename "$0") list-profiles --ds $ds_dest"
    green "  Then use the full XCCDF profile ID, e.g. --profile xccdf_org.ssgproject.content_profile_stig"

    rm -rf "$tmp_dir"
    green "Done."
}

#-------------------------------------------------------------------------------
# Main
#-------------------------------------------------------------------------------
main() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        usage
    fi

    if [[ $# -lt 1 ]]; then
        usage
    fi

    local cmd="$1"; shift
    parse_args "$cmd" "$@"

    case "$cmd" in
        scan)         cmd_scan ;;
        plan)         cmd_plan ;;
        remediate)    cmd_remediate ;;
        generate)     cmd_generate ;;
        list-profiles) cmd_list_profiles ;;
        info)         cmd_info ;;
        fetch)        cmd_fetch ;;
        fix-cpe)      cmd_fix_cpe ;;
        *)            die "Unknown command: $cmd" ;;
    esac
}

main "$@"
